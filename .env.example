# Production URL, e.g. https://example.com. Empty uses Vercel URL, then localhost.
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 (optional), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Search Console HTML-tag token only (optional)
GOOGLE_SITE_VERIFICATION=
# Kakao JavaScript key (optional)
NEXT_PUBLIC_KAKAO_JS_KEY=
